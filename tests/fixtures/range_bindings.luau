local single = NumberRange.new(3.5)
local range = NumberRange.new(-2, 7)
assert(single.Min == 3.5 and single.Max == 3.5)
assert(range.Min == -2 and range.Max == 7)
assert(single == NumberRange.new(3.5))
assert(single ~= range)
assert(typeof(range) == "NumberRange")
assert(tostring(range) == "-2, 7")
assert(not pcall(function() NumberRange.new(2, 1) end))
assert(not pcall(function() NumberRange.new(0/0) end))
assert(not pcall(function() single.Min = 0 end))

local rect = Rect.new(2, 4, 11, 19)
assert(Rect.new(Vector2.new(2, 4), Vector2.new(11, 19)) == rect)
local normalized = Rect.new(3, 4, 1, 2)
assert(normalized.Min == Vector2.new(1, 2))
assert(normalized.Max == Vector2.new(3, 4))
assert(Rect.new(Vector2.new(3, 4), Vector2.new(1, 2)) == normalized)
assert(rect.Width == 9 and rect.Height == 15)
assert(rect.Min == Vector2.new(2, 4))
assert(rect.Max == Vector2.new(11, 19))
assert(rect == Rect.new(2, 4, 11, 19))
assert(rect ~= Rect.new(2, 4, 11, 20))
assert(typeof(rect) == "Rect")
assert(tostring(rect) == "2, 4, 11, 19")
assert(not pcall(function() Rect.new(0, 1, math.huge, 2) end))
assert(not pcall(function() rect.Width = 12 end))
return "NumberRange and Rect fixtures passed"
