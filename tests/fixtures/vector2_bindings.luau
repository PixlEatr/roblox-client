local a = Vector2.new(3, 4)
local b = Vector2.new(-2, 5)
assert(a.X == 3 and a.Y == 4)
assert(math.abs(a.Magnitude - 5) < 1e-12)
assert(a.Unit == Vector2.new(0.6, 0.8))
assert(a:Dot(b) == 14)
assert(a:Cross(b) == 23)
assert(a:Lerp(b, 0.5) == Vector2.new(0.5, 4.5))
assert(Vector2.Min(a, b) == Vector2.new(-2, 4))
assert(Vector2.Max(a, b) == Vector2.new(3, 5))
assert(a:Abs() == a)
assert(Vector2.new(1.2, -1.2):Floor() == Vector2.new(1, -2))
assert(Vector2.new(1.2, -1.2):Ceil() == Vector2.new(2, -1))
assert(Vector2.new(-1, 0):Sign() == Vector2.new(-1, 0))
assert(a + b == Vector2.new(1, 9))
assert(a - b == Vector2.new(5, -1))
assert(a * 2 == Vector2.new(6, 8))
assert(2 * a == Vector2.new(6, 8))
assert(a * b == Vector2.new(-6, 20))
assert(a / 2 == Vector2.new(1.5, 2))
local zeroUnit = Vector2.zero.Unit
assert(zeroUnit.X ~= zeroUnit.X and zeroUnit.Y ~= zeroUnit.Y)
assert(Vector2.xAxis == Vector2.new(1, 0) and Vector2.yAxis == Vector2.new(0, 1))
assert(typeof(a) == "Vector2")
assert(tostring(a) == "3, 4")

assert(Vector2.new()==Vector2.zero)
assert(Vector2.new(3)==Vector2.new(3,0))
assert(not pcall(function() Vector2.new(0/0, 1) end))
assert(not pcall(function() a.X = 9 end))
assert(not pcall(function() return a / 0 end))

return "Vector2 fixture passed"
