local workspace = game:GetService("Workspace")
local run = game:GetService("RunService")
local players = game:FindFirstChild("Players")
local settings = UserSettings()
assert(game:IsA("DataModel"))
assert(typeof(game) == "Instance")
assert(game:IsA("Object") and workspace:IsA("Model") and workspace:IsA("WorldRoot"))
assert(workspace == game:GetService("Workspace"))
assert(rawequal(workspace, game:GetService("Workspace")))
assert(workspace.Parent == game)
assert(workspace.Name == "Workspace" and workspace.ClassName == "Workspace")
assert(workspace == game:GetService("Workspace") and typeof(workspace) == "Instance")
assert(run:IsA("RunService") and run:IsStudio() == true and run:IsRunning())
assert(players and players.Parent == game)
assert(settings.Name == "GlobalBasicSettings" and settings:IsA("UserSettings"))
assert(settings:IsA("GenericSettings") and settings:IsA("ServiceProvider"))
assert(tostring(settings) == "GlobalBasicSettings")
assert(game.JobId == "offline-fixture-job")
assert(game:FindService("MissingService") == nil)
assert(not pcall(function() return game:GetService("NotEnabled") end))
local ok = pcall(function() workspace.Name = "changed" end)
assert(not ok)
return true, #game:GetChildren()
